# Copy this file to .env in the launch directory or target workspace, then fill in all three.
# Exported shell variables take priority over .env. Do not commit your real key.
HIRO_API_KEY=your-key
# API base URL only; Hiro appends /chat/completions.
HIRO_BASE_URL=https://your-provider.example/v1
HIRO_MODEL=your-tool-calling-model
